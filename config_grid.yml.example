# Sample config for train_geo_model.py (grid training).
# Replace X.YY / X_YY and the export name for your run.
#
#   cd /disk/mnt/data/experiments/geo_prior_tf/X_YY_grid
#   python3 /disk/mnt/data/repos/inatGeoModelTraining/train_geo_model.py --config_file config_X_YY_grid.yml
#   python3 /disk/mnt/data/repos/inatGeoModelTraining/evaluate_geo_model.py --config_file config_X_YY_grid.yml

dataset_dir: "/disk/mnt/data/exports/vision-export-YYYYMMDDHHMMSS-aka-X.YY"
export_short_version: "X_YY_grid"
experiment_dir: "/disk/mnt/data/experiments/geo_prior_tf/X_YY_grid/"
elevation_file: "/disk/mnt/data/repos/inatGeoModelTraining/elevation_h3_resolution6.csv"

dataset_type: "inat"
train_only_cid_data: True
train_only_wild_data: False
h3_resolution: 6
num_random_samples: 100000
inner_nodes: False

batch_size: 1024
num_epochs: 200
initial_lr: 0.0005
lr_warmup_cosine_decay: True
shuffle_buffer_size: 50000
full_shuffle_before_tfrecords: False

wandb_project: "geomodel_tf"

# read by evaluate_geo_model.py (thresholds, then taxon range evaluation)
eval:
  taxon_range_eval_dir: "/disk/mnt/data/exports/taxon_range_eval-YYYYMMDDHHMMSS-vision-export-YYYYMMDDHHMMSS-aka-X.YY"
  elevation_tif: "/disk/mnt/data/repos/inatVisionAPI/wc2.1_5m_elev.tif"
  # not the training h3_resolution above
  h3_resolution: 4
